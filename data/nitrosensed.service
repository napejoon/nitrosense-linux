[Unit]
Description=NitroSense for Linux hardware service (Acer WMI: fans, keyboard lighting, power plans)
After=systemd-modules-load.service power-profiles-daemon.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe acpi_call
ExecStart=/opt/nitrosense/bin/nitrosensed
Restart=on-failure
RestartSec=3
RuntimeDirectory=nitrosense
RuntimeDirectoryMode=0755
StateDirectory=nitrosense
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
